{
  "version": 1,
  "tasks": [
    {
      "id": "C01",
      "schema": "commerce",
      "split": "dev",
      "category": "outer_aggregation",
      "prompt": "For every customer, sum revenue of all their paid-order lines; return zero for no such lines.",
      "semantics": "customer_id integer, revenue_cents integer; bag, one row/customer",
      "ordered": false,
      "columns": [
        {
          "name": "customer_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "revenue_cents",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "C02",
      "schema": "commerce",
      "split": "assessment",
      "category": "anti_null",
      "prompt": "Return customers with no paid orders, including customers with no orders. A paid order with zero lines still disqualifies.",
      "semantics": "customer_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "customer_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "C03",
      "schema": "commerce",
      "split": "dev",
      "category": "join_multiplicity",
      "prompt": "Return customers having at least two paid orders and their count of paid orders. Zero-line orders count once; multiple lines do not increase the count.",
      "semantics": "customer_id integer, paid_order_count integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "customer_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "paid_order_count",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "C04",
      "schema": "commerce",
      "split": "dev",
      "category": "ties",
      "prompt": "For each customer with any paid orders, select the most recent paid order by ordered_on; break date ties by greatest order ID.",
      "semantics": "customer_id integer, order_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "customer_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "order_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "C05",
      "schema": "commerce",
      "split": "dev",
      "category": "time_boundary",
      "prompt": "Sum paid-order line revenue for ordered_on >= 2025-01-01 and < 2025-02-01, returning one zero if there are no qualifying lines.",
      "semantics": "revenue_cents integer; exactly one row",
      "ordered": false,
      "columns": [
        {
          "name": "revenue_cents",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "C06",
      "schema": "commerce",
      "split": "assessment",
      "category": "ordering",
      "prompt": "Return at most two customers by paid-line revenue, including zero-revenue customers, ordered revenue descending then customer ID ascending.",
      "semantics": "customer_id integer, revenue_cents integer; ordered",
      "ordered": true,
      "columns": [
        {
          "name": "customer_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "revenue_cents",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "C07",
      "schema": "commerce",
      "split": "assessment",
      "category": "duplicates",
      "prompt": "For every line of a paid order, emit its SKU once per line (not once per quantity). Retain repeated SKUs from different lines.",
      "semantics": "sku text; bag",
      "ordered": false,
      "columns": [
        {
          "name": "sku",
          "type": "text",
          "nullable": false
        }
      ]
    },
    {
      "id": "C08",
      "schema": "commerce",
      "split": "assessment",
      "category": "relational_division",
      "prompt": "Return customers who bought both SKU A and SKU B on paid orders; the items may be on different orders. Zero-priced lines qualify.",
      "semantics": "customer_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "customer_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "S01",
      "schema": "support",
      "split": "assessment",
      "category": "outer_aggregation",
      "prompt": "For every agent count assigned tickets, including zero for agents without tickets. Unassigned tickets belong to no agent.",
      "semantics": "agent_id integer, ticket_count integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "agent_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "ticket_count",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "S02",
      "schema": "support",
      "split": "dev",
      "category": "anti_null",
      "prompt": "Return agents with no assigned unresolved tickets (resolved_on IS NULL). Agents without tickets qualify; unassigned tickets do not disqualify anyone.",
      "semantics": "agent_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "agent_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "S03",
      "schema": "support",
      "split": "assessment",
      "category": "join_multiplicity",
      "prompt": "Return tickets with at least two reply events and the count of replies only. Notes do not count.",
      "semantics": "ticket_id integer, reply_count integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "ticket_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "reply_count",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "S04",
      "schema": "support",
      "split": "assessment",
      "category": "ties",
      "prompt": "For each ticket with reply events, return earliest reply by happened_on, breaking date ties by smallest event ID.",
      "semantics": "ticket_id integer, event_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "ticket_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "event_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "S05",
      "schema": "support",
      "split": "assessment",
      "category": "time_boundary",
      "prompt": "Return tickets opened >= 2025-01-01 and < 2025-02-01 that were still unresolved at the start of 2025-02-01: resolved_on is NULL or >= 2025-02-01.",
      "semantics": "ticket_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "ticket_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "S06",
      "schema": "support",
      "split": "dev",
      "category": "ordering",
      "prompt": "Return at most three currently unresolved tickets (resolved_on IS NULL) ordered priority descending then ticket ID ascending, including unassigned tickets.",
      "semantics": "ticket_id integer, priority integer; ordered",
      "ordered": true,
      "columns": [
        {
          "name": "ticket_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "priority",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "S07",
      "schema": "support",
      "split": "dev",
      "category": "duplicates",
      "prompt": "Return distinct team names of agents assigned at least one ticket. Two agents in the same team still produce one row. Unassigned tickets contribute nothing.",
      "semantics": "team text; bag",
      "ordered": false,
      "columns": [
        {
          "name": "team",
          "type": "text",
          "nullable": false
        }
      ]
    },
    {
      "id": "S08",
      "schema": "support",
      "split": "dev",
      "category": "relational_division",
      "prompt": "Return agents assigned at least one high-priority ticket (priority >= 2) and at least one low-priority ticket (priority = 0). The tickets may be resolved or unresolved. Priority 1 is neither.",
      "semantics": "agent_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "agent_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "B01",
      "schema": "billing",
      "split": "dev",
      "category": "numeric",
      "prompt": "Return every invoice with its outstanding cents: total_cents minus sum of all its payments, treating absent payments as zero. Negative outstanding is retained.",
      "semantics": "invoice_id integer, outstanding_cents integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "invoice_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "outstanding_cents",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "B02",
      "schema": "billing",
      "split": "assessment",
      "category": "aggregation",
      "prompt": "Return accounts whose combined outstanding cents across all invoices is positive, with that combined amount. No-invoice accounts have zero and do not qualify; overpayments offset unpaid invoices.",
      "semantics": "account_id integer, outstanding_cents integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "account_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "outstanding_cents",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "B03",
      "schema": "billing",
      "split": "dev",
      "category": "empty_result",
      "prompt": "Return invoices that have no payment records, even if total_cents is zero. Any payment disqualifies.",
      "semantics": "invoice_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "invoice_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "B04",
      "schema": "billing",
      "split": "assessment",
      "category": "universal",
      "prompt": "Return accounts with at least one invoice and no invoice whose outstanding cents is positive. Zero/overpaid invoices qualify as paid; no-invoice accounts do not qualify.",
      "semantics": "account_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "account_id",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "B05",
      "schema": "billing",
      "split": "dev",
      "category": "grouping",
      "prompt": "For each year-month appearing in invoice issue dates, sum total_cents (not payments), sorted year-month ascending. Include a zero total month if it has invoices.",
      "semantics": "month text formatted YYYY-MM, billed_cents integer; ordered",
      "ordered": true,
      "columns": [
        {
          "name": "month",
          "type": "text",
          "nullable": false
        },
        {
          "name": "billed_cents",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "B06",
      "schema": "billing",
      "split": "assessment",
      "category": "window",
      "prompt": "Return each payment and the cumulative paid amount for its invoice through that payment in (paid_on ascending, payment ID ascending) order. Return all rows ordered invoice ID, paid_on, payment ID ascending.",
      "semantics": "invoice_id integer, payment_id integer, cumulative_cents integer; ordered",
      "ordered": true,
      "columns": [
        {
          "name": "invoice_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "payment_id",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "cumulative_cents",
          "type": "integer",
          "nullable": false
        }
      ]
    },
    {
      "id": "B07",
      "schema": "billing",
      "split": "assessment",
      "category": "numeric",
      "prompt": "For each account plan represented by at least one invoice, return the average invoice total_cents across invoices in that plan. Each invoice has equal weight, not each account.",
      "semantics": "plan text, mean_cents real; bag",
      "ordered": false,
      "columns": [
        {
          "name": "plan",
          "type": "text",
          "nullable": false
        },
        {
          "name": "mean_cents",
          "type": "real",
          "nullable": false
        }
      ]
    },
    {
      "id": "B08",
      "schema": "billing",
      "split": "dev",
      "category": "time_boundary",
      "prompt": "Return active accounts with no invoice issued >= 2025-01-01 and < 2025-02-01. Inactive accounts never qualify; invoices outside January do not disqualify.",
      "semantics": "account_id integer; bag",
      "ordered": false,
      "columns": [
        {
          "name": "account_id",
          "type": "integer",
          "nullable": false
        }
      ]
    }
  ]
}
